generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessProfile BusinessProfile?
  clients         Client[]
  projects        Project[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  paymentDetails  PaymentDetail[]
}

model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String  @default("My Business")
  address      String  @default("")
  phone        String  @default("")
  email        String  @default("")
  logoUrl      String?

  bankName          String @default("")
  bankAccountNumber String @default("")
  wiseEmail         String @default("")

  defaultCurrency String @default("INR")
  defaultTaxRate  Float  @default(5)
  invoiceNotes    String @default("Thank you for your business. Please make payment within 30 days. Contact us with any questions regarding this invoice or payment details.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  email     String
  address   String  @default("")
  phone     String  @default("")
  avatarUrl String?

  projects Project[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  name        String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  budget      Float         @default(0)
  startDate   DateTime      @default(now())
  endDate     DateTime?

  invoices Invoice[]
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  invoiceNumber String
  currency      String        @default("INR")
  status        InvoiceStatus @default(DRAFT)

  issuedDate DateTime @default(now())
  dueDate    DateTime

  taxRate    Float @default(5)
  subtotal   Float @default(0)
  taxAmount  Float @default(0)
  total      Float @default(0)
  amountPaid Float @default(0)
  amountDue  Float @default(0)

  notes String @default("")

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId, status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  name      String
  quantity  Float  @default(1)
  unit      String @default("unit")
  cost      Float  @default(0)
  amount    Float  @default(0)
  sortOrder Int    @default(0)
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  WISE
  OTHER
}

model Payment {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Float
  method    PaymentMethod @default(BANK_TRANSFER)
  paidAt    DateTime      @default(now())
  reference String        @default("")
  notes     String        @default("")

  createdAt DateTime @default(now())
}

enum PaymentDetailType {
  BANK
  UPI
  LINK
  QR_CODE
  OTHER
}

model PaymentDetail {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    String
  type     PaymentDetailType @default(BANK)
  details  String            @default("")
  imageUrl String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  category    String
  description String   @default("")
  amount      Float
  date        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
